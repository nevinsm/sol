{
  "$id": "https://github.com/nevinsm/sol/internal/cliapi/broker/status-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "type": "string"
    },
    "patrol_count": {
      "type": "integer"
    },
    "runtimes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "last_probe_at": {
            "format": "date-time",
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "runtime": {
            "type": "string"
          }
        },
        "required": [
          "runtime",
          "ok"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stale": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "checked_at",
    "patrol_count",
    "stale"
  ],
  "type": "object"
}
